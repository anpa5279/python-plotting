#!/bin/bash
nodes=1
cpus=16
jobn=postprocessing
file=oceananigans_setup.py

cp $file scripts/
cp diagnostics.py scripts/
cp interpolation.py scripts/
cp reader.py scripts/
cp physics.py scripts/

###uv init scripts
cd scripts

cat > EXEC_STEP << EXEC
#!/bin/sh

#PBS -A UCUB0166
#PBS -N $jobn
#PBS -q develop 
#PBS -j oe
#PBS -l walltime=00:40:00
#PBS -l select=1:ncpus=$cpus

module --force purge
module load ncarenv/25.10 uv

uv run python $file

EXEC

qsub < EXEC_STEP
#!/bin/bash
nodes=1
cpus=16
jobn=condense_files
file=oceananigans_condense_files.py

cp $file scripts/
cp reader.py scripts/

###uv init scripts
cd scripts

cat > CONDENSE << EXEC
#!/bin/sh

#PBS -A UCUB0166
#PBS -N $jobn
#PBS -q develop 
#PBS -j oe
#PBS -l walltime=03:00:00
#PBS -l select=1:ncpus=$cpus:mem=235GB

module --force purge
module load ncarenv/25.10 uv

uv run python $file

EXEC

qsub < CONDENSE
#!/bin/bash

nodes=1
cpus=16
jobn=postprocessing
file=oceananigans_setup.py

cp "$file" diagnostics.py interpolation.py reader.py physics.py scripts/

cd scripts || exit 1

cat > EXEC_STEP << EXEC
#!/bin/bash
#SBATCH --account=ucb-general
#SBATCH --partition=acpu
#SBATCH --qos=cpu-testing
#SBATCH --job-name=$jobn
#SBATCH --time=03:30:00
#SBATCH --nodes=$nodes
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=$cpus
#SBATCH --mem=150G
#SBATCH --output=$jobn-%j.out

module --force purge

module load intel uv

uv init --bare


uv add numpy h5py dask scipy

uv run python $file
EXEC

sbatch EXEC_STEP
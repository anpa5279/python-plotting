#!/bin/bash

nodes=1
cpus=2
jobn=postprocessing
file=oceananigans_setup.py

cp "$file" diagnostics.py interpolation.py reader.py physics.py scripts/

cd scripts || exit 1

cat > EXEC_STEP << EXEC
#!/bin/bash -l
#SBATCH --export=NONE
#SBATCH --account=ucb-general
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --job-name=$jobn
#SBATCH --time=06:00:00
#SBATCH --nodes=$nodes
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=$cpus
#SBATCH --mem=100G
#SBATCH --output=$jobn-%j.out

module load intel/2024.2.1 uv

[ -f pyproject.toml ] || uv init --bare
uv add numpy h5py dask scipy

uv run python $file
EXEC

sbatch EXEC_STEP
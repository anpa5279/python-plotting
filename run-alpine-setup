#!/bin/bash

nodes=1
cpus=16
jobn=postprocessing
file=oceananigans_setup.py

cp "$file" diagnostics.py interpolation.py reader.py physics.py scripts/

cd scripts || exit 1

cat > EXEC_STEP << EXEC
#!/bin/bash
#SBATCH --account=ucb-general
#SBATCH --partition=amem
#SBATCH --qos=mem-normal
#SBATCH --job-name=$jobn
#SBATCH --time=03:30:00
#SBATCH --nodes=$nodes
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=$cpus
#SBATCH --mem=256G
#SBATCH --output=$jobn-%j.out

echo "MODULEPATH before: $MODULEPATH"
module list
module --force purge
echo "MODULEPATH after: $MODULEPATH"
module avail intel 2>&1 | head -20
module spider intel 2>&1 | head -30

#module purge

module --ignore_cache load intel uv

uv init --bare

uv add numpy h5py dask scipy

uv run python $file
EXEC

sbatch EXEC_STEP